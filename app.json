{
  "expo": {
    "name": "igen connect",
    "slug": "igen-connect",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/igen-connect.png",
    "scheme": "igenconnect",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "16.4",
      "requireFullScreen": true,
      "bundleIdentifier": "com.igen.bni",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.igen.connect",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/igen-connect.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/igen-connect-transparent.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Cho phép iGen Connect sử dụng Face ID để đăng nhập và check-in."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cho phép iGen Connect sử dụng Face ID để đăng nhập và check-in."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép iGen Connect dùng camera để quét mã QR check-in, chụp ảnh hồ sơ và chụp ảnh hoặc quay video gửi trong trò chuyện.",
          "microphonePermission": "Cho phép iGen Connect dùng micro để gửi tin nhắn thoại và ghi âm khi quay video trong trò chuyện.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép iGen Connect dùng vị trí hiện tại khi bạn check-in để xác minh bạn đang trong khu vực cuộc họp.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": "Cho phép iGen Connect nhận biết trạng thái di chuyển của thiết bị để hỗ trợ tính năng vị trí khi check-in cuộc họp."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép iGen Connect truy cập ảnh và video bạn chọn để cập nhật ảnh hồ sơ, ảnh cuộc họp hoặc gửi trong trò chuyện.",
          "cameraPermission": "Cho phép iGen Connect dùng camera để quét mã QR check-in, chụp ảnh hồ sơ và chụp ảnh hoặc quay video gửi trong trò chuyện.",
          "microphonePermission": "Cho phép iGen Connect dùng micro để gửi tin nhắn thoại và ghi âm khi quay video trong trò chuyện."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "Cho phép iGen Connect dùng micro để gửi tin nhắn thoại và ghi âm khi quay video trong trò chuyện.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-video",
      "expo-screen-orientation",
      [
        "expo-notifications",
        {
          "color": "#00AECA",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-asset",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ],
      "./plugins/withMinimalBackgroundModes"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b205af1a-0627-4bbc-8db3-cc39bbdf903b"
      }
    },
    "owner": "igen-technology"
  }
}
