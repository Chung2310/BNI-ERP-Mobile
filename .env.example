EXPO_PUBLIC_API_URL=https://erp-api.example.com
# Optional fallback for Expo Push Service only; GitHub iOS signing/build does not use this variable.
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
ANDROID_VERSION_CODE=1
# Optional path to Android Firebase client config, defaults to ./google-services.json
# GOOGLE_SERVICES_JSON=./google-services.json
# For a local signed Android build, provide these securely (never commit keys).
# ANDROID_KEYSTORE_PATH=C:/secure/igen-upload.jks
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=igen-upload
# ANDROID_KEY_PASSWORD=
