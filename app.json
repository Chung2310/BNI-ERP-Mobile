{
  "expo": {
    "name": "iGen Connect",
    "slug": "igen-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "igenconnect",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.igen.connect"
    },
    "android": {
      "package": "vn.igen.connect",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7FAFB"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Cho phép iGen Connect sử dụng Face ID để đăng nhập."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cho phép iGen Connect sử dụng Face ID để đăng nhập."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép iGen Connect sử dụng camera để quét mã QR check-in.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép iGen Connect sử dụng vị trí để xác minh phạm vi check-in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép iGen Connect truy cập thư viện ảnh để chọn ảnh bìa cuộc họp."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
